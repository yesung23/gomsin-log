# 곰신로그 환경변수 예시
#
# 이 파일을 `.env` 로 복사한 뒤 값을 채우세요.
# `.env` 는 .gitignore 에 있어 Git에 올라가지 않습니다.

# Supabase 프로젝트 주소
# 대시보드 → Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# 공개(publishable / anon) 키
# 대시보드 → Settings → API → Project API keys → anon public
# 이 키는 브라우저에 노출되어도 됩니다. 접근 통제는 RLS 정책이 담당합니다.
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Sentry browser error reports. This project identifier is visible in the
# browser and is not an administrator secret. Reporting stays off unless the
# enable flag is exactly `true` and a DSN is present.
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=

# 법적 문서에 표시될 실제 운영자명과 개인정보 문의 이메일
# 출시 전 Vercel Production 환경변수에도 반드시 같은 값을 설정하세요.
VITE_LEGAL_OPERATOR_NAME=your-name-or-business-name
VITE_PRIVACY_CONTACT_EMAIL=privacy@example.com

# Native device-protection ceremony. Requires native Capacitor build and explicit
# true to enable. Web/PWA and omitted/false stay off fail-safe.
VITE_E2EE_DEVICE_PROTECTION_ENABLED=false

# Push infrastructure is preserved, but the active product keeps permission
# prompts/token registration/browser system notifications OFF unless a later
# release explicitly opts in.
VITE_PUSH_NOTIFICATIONS_ENABLED=false

# Sign in with Apple stays unavailable unless a reviewed build explicitly sets
# this exact value to true AND GoTrue reports the Apple provider enabled.
VITE_APPLE_LOGIN_ENABLED=false

# iOS Foundation Models daily-summary refinement. It stays off unless a reviewed
# build sets the exact value true. Generation starts from the Story AI button,
# and deterministic rule-based summary is always the fallback on web, Android,
# unsupported devices, timeout, or invalid output.
VITE_ON_DEVICE_DAILY_SUMMARY_ENABLED=false

# Multi-day Partner Briefing. Exact `true` enables the deterministic briefing
# surface; model refinement is offered only after a content-free native
# availability preflight. No server/cloud AI fallback is used.
VITE_PARTNER_BRIEFING_ENABLED=false

# ---------------------------------------------------------------------------
# 절대 여기에 넣지 마세요:
#   - service_role 키  (모든 RLS 정책을 무시합니다)
#   - 데이터베이스 비밀번호
#   - Google OAuth client secret
#
# service_role 키는 Supabase Edge Function 환경변수로만 설정합니다.
# (대시보드 → Edge Functions → delete-account → Secrets)
#
# VITE_ 로 시작하는 값은 모두 프론트엔드 번들에 그대로 포함되어
# 누구나 볼 수 있습니다.
# ---------------------------------------------------------------------------
