# Capacitor native projects are TRACKED, not regenerated.
#
# The manifest, Gradle config, entitlements, Info.plist and privacy manifest are
# review surfaces: a permission or a backup rule that only exists on one
# maintainer's disk cannot be code-reviewed, and `cap add` would silently revert
# every hardening decision. See docs/kiro/NATIVE_RELEASE_GUIDE.md for the
# decision and its tradeoff.
#
# What must NEVER be tracked is build output, machine-local paths, resolved
# dependency caches and signing material. Those rules live below and in
# android/.gitignore + ios/.gitignore.

# --- Android: build output and machine-local state ---
/android/.gradle/
/android/build/
/android/app/build/
/android/captures/
/android/local.properties
/android/.idea/
/android/*.iml
/android/app/release/
/android/app/google-services.json
# Regenerated by `cap sync android` from capacitor.config.ts + package.json.
/android/capacitor-cordova-android-plugins/
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json
/android/app/src/main/res/xml/config.xml

# --- iOS: build output, CocoaPods resolution and Xcode user state ---
/ios/App/build/
/ios/App/Pods/
/ios/App/output/
/ios/DerivedData/
# Podfile.lock IS tracked: all four pods are local `:path` references into
# node_modules, so the lock is a deterministic function of package-lock.json and
# pins the exact podspec checksums the release was built against.
**/xcuserdata/
**/*.xcuserdatad
# Regenerated by `cap sync ios` from capacitor.config.ts + package.json.
/ios/capacitor-cordova-ios-plugins/
/ios/App/App/public/
/ios/App/App/capacitor.config.json
/ios/App/App/config.xml

# --- Signing material -- must never be committed, on either platform ---
*.keystore
*.jks
keystore.properties
*.p12
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
/ios/App/ExportOptions.plist
/fastlane/

# TypeScript incremental build cache (build artifact)
*.tsbuildinfo

# Deno 2 writes this the first time `npm run check:edge` / `npm run test:edge`
# runs, so the documented validation commands dirtied the working tree. It has
# never been tracked: the Edge Function pins its dependencies in the import URLs
# themselves, so the lock adds no reproducibility the repo does not already have.
deno.lock

# Scratch output from review tooling. Conclusions that matter are written into
# docs/kiro/RELEASE_AUDIT_2026-07-31.md instead.
/semantic-review

# Playwright artifacts (traces, screenshots, HTML report) -- never tracked.
e2e/.artifacts/
