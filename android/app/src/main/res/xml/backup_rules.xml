<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 (API 30) and older, where `android:fullBackupContent` is the
    control. Redundant with android:allowBackup="false" by itself; kept so the
    exclusion is stated explicitly on both sides of the API 31 split and so a
    future maintainer who flips allowBackup does not silently start backing up
    diary content. See data_extraction_rules.xml for the API 31+ equivalent.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
